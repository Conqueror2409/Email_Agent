# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM_NAME=Your Name

# IMAP Configuration (for reading replies)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=#email-notifications

# Agent Configuration
# Retarget after how many days (default 3-4 days, pick 3)
RETARGET_AFTER_DAYS=3
MAX_RETARGET_ATTEMPTS=2
# Check for replies every X hours
REPLY_CHECK_INTERVAL_HOURS=6

# Database Path
DB_PATH=email_agent.db
